DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database: leave DATABASE_URL empty to use SQLite
DATABASE_URL=postgres://grokbot:grokbot@postgres:5432/grokbot

REDIS_URL=redis://redis:6379/0

# Paper trading
PAPER_MODE=1
PAPER_STARTING_BALANCE=1000.00
PAPER_FEE_BPS=30
PAPER_SLIPPAGE_BPS=50

# xAI Grok (OpenAI-compatible)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini

# Scanner thresholds
SCAN_MIN_LIQUIDITY_USD=50000
SCAN_MIN_VOLUME_24H=10000
SCAN_MIN_BUY_SELL_RATIO=1.1
SCAN_MAX_PAIR_AGE_HOURS=72
SCAN_MAX_FDV_LIQUIDITY_RATIO=50

# Risk guard defaults
RISK_MAX_POSITION_PCT=15
RISK_MAX_OPEN_POSITIONS=5
RISK_DAILY_LOSS_KILL_PCT=10
RISK_MAX_TRADES_PER_HOUR=20
RISK_MIN_CONFIDENCE=0.55
RISK_MANDATORY_SL_TP=1

# Celery beat / agent tick interval (seconds)
AGENT_TICK_SECONDS=30
