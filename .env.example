DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database: leave DATABASE_URL empty to use SQLite
DATABASE_URL=postgres://grokbot:grokbot@postgres:5432/grokbot

REDIS_URL=redis://redis:6379/0

# Paper trading
PAPER_MODE=1
PAPER_STARTING_BALANCE=1000.00
PAPER_FEE_BPS=30
PAPER_SLIPPAGE_BPS=50

# xAI Grok (OpenAI-compatible)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini

# Scanner thresholds
SCAN_MIN_LIQUIDITY_USD=50000
SCAN_MIN_VOLUME_24H=10000
SCAN_MIN_BUY_SELL_RATIO=1.1
SCAN_MAX_PAIR_AGE_HOURS=72
SCAN_MAX_FDV_LIQUIDITY_RATIO=50

# Risk guard defaults
RISK_MAX_POSITION_PCT=15
RISK_MAX_OPEN_POSITIONS=5
RISK_DAILY_LOSS_KILL_PCT=10
RISK_MAX_TRADES_PER_HOUR=20
RISK_MIN_CONFIDENCE=0.62
SCAN_INTERVAL_SECONDS=120
DAILY_TARGET_PCT=15
CHAINS_TO_SCAN=solana,ethereum,base,bsc
RUG_CHECK_ENABLED=1
RUG_DEV_WALLET_PCT_MAX=0.12
RISK_MANDATORY_SL_TP=1

# Jev (TypeSafe) fast gate — https://jevtypesafeai.com/jev/api
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BUY_CONFIDENCE_THRESHOLD=0.72
JEV_EXIT_CONFIDENCE_THRESHOLD=0.6
JEV_EXIT_NOUL_THRESHOLD=0.65

# Decision pipeline: jev+grok | grok-only | jev-only | mock
DECIDER_MODE=jev+grok
GROK_MIN_CONFIDENCE=0.65

# Selective scalp defaults (tight TP / SL)
DEFAULT_STOP_LOSS_PCT=3.0
DEFAULT_TAKE_PROFIT_PCT=4.5
DEFAULT_POSITION_SIZE_PCT=6.0
MAX_TAKE_PROFIT_PCT=6.0
MAX_STOP_LOSS_PCT=4.0
PAPER_POSITION_TIMEOUT_HOURS=1.5

# Dashboard win-rate target (e.g. 50/60 ≈ 83%)
WIN_RATE_TARGET_WINS=50
WIN_RATE_TARGET_CLOSED=60

# Celery beat / agent tick interval (seconds)
AGENT_TICK_SECONDS=30
